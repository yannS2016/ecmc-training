# This course is authored on Windows and executed on a Linux (Rocky 9) host.
# Line endings are therefore not cosmetic: a shell script checked out with CRLF
# fails on Linux with the unhelpful "/usr/bin/env: 'bash\r': No such file or
# directory". Pin them here rather than relying on each cloner's core.autocrlf.

# Default: normalise to LF in the repository, let Git decide in the work tree.
* text=auto eol=lf

# Executed on the Linux host -- must be LF in the work tree too.
*.sh        text eol=lf
*.cmd       text eol=lf
*.pl        text eol=lf
*.py        text eol=lf
Makefile    text eol=lf
*.substitutions text eol=lf
*.db        text eol=lf
*.dbd       text eol=lf
*.template  text eol=lf
*.cpp       text eol=lf
*.c         text eol=lf
*.h         text eol=lf

# EPICS build system files carry no extension.
configure/* text eol=lf

# Documentation and config read on both sides.
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.conf      text eol=lf
*.example   text eol=lf
