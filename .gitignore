# site-local paths, never committed
site.conf
configure/RELEASE.local
ecmcPaths.cmd
00-bootstrap/deps.lock
**/ecmcPaths.cmd
**/configure/RELEASE.local
configure/CONFIG_SITE.local
**/configure/CONFIG_SITE.local

# EPICS build output.
# ANCHORED to the application directory on purpose. Unanchored "db/" matches at
# any depth, which silently swallows hand-written templates in a phase's own
# db/ directory -- content, not build output.
00-bootstrap/ecmcTrainingApp/bin/
00-bootstrap/ecmcTrainingApp/lib/
00-bootstrap/ecmcTrainingApp/dbd/
00-bootstrap/ecmcTrainingApp/db/
00-bootstrap/ecmcTrainingApp/include/
O.*/
envPaths

# staged ecmccfg install (regenerate with 00-bootstrap/stage-ecmccfg.sh)
stage/

# editor / OS
*.swp
*~
.DS_Store

# generated delivery patch (the repo itself is the source of truth)
*.patch
# ...but the ethercatmaster kernel-module patches are content and must be
# tracked. ecmc's own build fixes are applied by make-demo-branch.sh instead
# of a patch file -- see 00-bootstrap/make-demo-branch.sh.
!ethercatmaster/patches/*.patch

# scratch: build and bus output pasted in during a session
error
logs
*.logs
