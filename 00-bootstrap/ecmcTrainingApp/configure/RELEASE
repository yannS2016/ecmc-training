# RELEASE -- paths to EPICS SUPPORT MODULES only.
#
# DO NOT EDIT for site paths. This carries defaults only; bootstrap.sh generates
# configure/RELEASE.local from site.conf, and that overrides everything here.
#
# WHAT BELONGS IN THIS FILE
# -------------------------
# Only real EPICS support modules: a built source tree with its own
# configure/RELEASE, lib/, dbd/ and db/, participating in the EPICS module
# dependency system. convertRelease.pl validates these, and CHECK_RELEASE=YES
# fails the build when one is wrong.
#
# Paths to external libraries and tools do NOT belong here. They go in
# configure/CONFIG_SITE, which is exactly what it is for.
#
# ecmc's own configure/RELEASE does not follow this: it puts EXPRTK, RUCKIG,
# ETHERLAB, ECMCCFG and ECMCCOMP alongside ASYN and MOTOR, although only the
# last two are EPICS modules. ruckig is a CMake project, etherlab an autotools
# install prefix, and ecmccfg/ecmccomp are script trees with no configure/ at
# all. We split them properly here rather than inherit the mistake; see
# ../MODULES.md section 11.

# Module tree for this EPICS base version
SUPPORT = /epics/modules

ASYN  = $(SUPPORT)/asyn
MOTOR = $(SUPPORT)/motor
ECMC  = $(SUPPORT)/ecmc

# NB: no EXPRTK entry. Our application Makefile never references $(EXPRTK); it
# links libexprtkSupport, which ecmc builds into its own lib/$(EPICS_HOST_ARCH),
# so the -L comes from the ECMC entry above.

# EPICS_BASE last so earlier modules can override
EPICS_BASE = /epics/base

-include $(TOP)/configure/RELEASE.local
-include $(TOP)/configure/RELEASE.$(EPICS_HOST_ARCH).local
