# RELEASE - module paths for the ecmc training IOC.
#
# DO NOT EDIT THIS FILE for site paths.  It carries defaults only.
# 00-bootstrap/bootstrap.sh generates configure/RELEASE.local from site.conf,
# and RELEASE.local overrides everything below.
#
# Unlike a require/e3 site, dependency resolution happens HERE, at build time.
# That is the whole difference in one file -- see ../../appendix-require.md.

# Module tree for this EPICS base version (e.g. /epics/modules/7.0.7)
SUPPORT = /epics/modules

ASYN     = $(SUPPORT)/asyn
MOTOR    = $(SUPPORT)/motor
ECMC     = $(SUPPORT)/ecmc
ECMCCFG  = $(SUPPORT)/ecmccfg
# Source dependencies live outside the EPICS module tree; bootstrap.sh writes
# the real path into RELEASE.local from DEPS_DIR in site.conf.
RUCKIG   = /cds/group/pcds/pkg_mgr/ruckig

# exprtkSupport ships inside the ecmc source tree
EXPRTK   = $(ECMC)/exprtkSupport

# Etherlab EtherCAT master (libethercat + headers)
ETHERLAB = /opt/etherlab

# EPICS_BASE last so earlier modules can override
EPICS_BASE = /epics/base

-include $(TOP)/configure/RELEASE.local
-include $(TOP)/configure/RELEASE.$(EPICS_HOST_ARCH).local
