# =============================================================================
# Stage 1 -- open-loop stepper
#
# The smallest axis that moves. No position feedback, no limit switches, no
# software limits. ecmc commands a velocity; the motor is assumed to follow.
#
# An .ax file is NOT a special format -- it is plain iocsh, every line an
# epicsEnvSet. configureAxis.cmd sources it, then addAxis.cmd turns the
# variables into Cfg.* calls. That is the whole mechanism.
#
# HARDWARE ASSUMED (change to match yours):
#   EL7041-0052 at bus position $(DRV_POS), 1.8 deg motor (200 full steps/rev),
#   64x microstepping -> 12800 counts/rev, driving a 1 mm/rev leadscrew.
# =============================================================================

#General ----------------------------------------------------------------------
epicsEnvSet("ECMC_MOTOR_NAME",  "Axis1")     # PV name: $(DEV):Axis1
epicsEnvSet("ECMC_R",           "Axis1-")    # prefix for the ecmc-side PVs
epicsEnvSet("ECMC_AXIS_NO",     "1")         # ecmc axis id, used as ax1.* in PLC code
epicsEnvSet("ECMC_DESC",        "Training axis 1 (open loop)")
epicsEnvSet("ECMC_EGU",         "mm")        # motor record engineering unit
epicsEnvSet("ECMC_PREC",        "3")
epicsEnvSet("ECMC_AXISCONFIG",  "")
epicsEnvSet("ECMC_EC_AXIS_HEALTH", "")
epicsEnvSet("ECMC_MOD_RANGE",   "0")         # 0 = not a rotary/modulo axis
epicsEnvSet("ECMC_MOD_TYPE",    "0")

#Encoder ----------------------------------------------------------------------
# Even "open loop" needs an encoder object: ecmc must report SOME position, and
# the motor record must have a readback. We use the EL7041's own internal
# microstep counter. It tracks commanded steps, not the real load -- so it will
# happily report a perfect position through a stall. That is the whole lesson of
# stage 1, and why stage 2 exists.
#
# Scaling: 12800 counts/rev, 1 mm/rev  ->  1 mm per 12800 counts.
epicsEnvSet("ECMC_ENC_SCALE_NUM",   "1")
epicsEnvSet("ECMC_ENC_SCALE_DENOM", "12800")
epicsEnvSet("ECMC_ENC_TYPE",        "0")     # 0 = incremental
epicsEnvSet("ECMC_ENC_BITS",        "16")    # EL70xx internal counter is 16 bit
epicsEnvSet("ECMC_ENC_ABS_BITS",    "0")
epicsEnvSet("ECMC_ENC_ABS_OFFSET",  "0")
epicsEnvSet("ECMC_EC_ENC_ACTPOS",   "ec0.s$(DRV_POS=5).positionActual01")
epicsEnvSet("ECMC_EC_ENC_RESET",    "")
epicsEnvSet("ECMC_EC_ENC_ALARM_0",  "")
epicsEnvSet("ECMC_EC_ENC_ALARM_1",  "")
epicsEnvSet("ECMC_EC_ENC_ALARM_2",  "")
epicsEnvSet("ECMC_EC_ENC_WARNING",  "")

#Drive ------------------------------------------------------------------------
# DRV_SCALE_NUM is the speed in EGU at full-scale setpoint. The EL7041 velocity
# setpoint is a 16-bit signed value; 32768 corresponds to the terminal's
# configured maximum speed (default 2000 full steps/s = 10 rev/s = 10 mm/s here).
epicsEnvSet("ECMC_DRV_TYPE",        "0")        # 0 = stepper, 1 = DS402
epicsEnvSet("ECMC_DRV_SCALE_NUM",   "10.0")     # mm/s at full scale
epicsEnvSet("ECMC_DRV_SCALE_DENOM", "32768.0")

# Bit positions within the EL70xx control/status words:
epicsEnvSet("ECMC_EC_DRV_CONTROL",  "ec0.s$(DRV_POS=5).driveControl01.0")   # enable
epicsEnvSet("ECMC_EC_DRV_STATUS",   "ec0.s$(DRV_POS=5).driveStatus01.1")    # ready
epicsEnvSet("ECMC_EC_DRV_VELOCITY", "ec0.s$(DRV_POS=5).velocitySetpoint01")
epicsEnvSet("ECMC_EC_DRV_REDUCE_TORQUE", "ec0.s$(DRV_POS=5).driveControl01.2")
epicsEnvSet("ECMC_EC_DRV_BRAKE",    "")
epicsEnvSet("ECMC_DRV_BRAKE_OPEN_DLY_TIME",    "0")
epicsEnvSet("ECMC_DRV_BRAKE_CLOSE_AHEAD_TIME", "0")
epicsEnvSet("ECMC_EC_DRV_RESET",    "ec0.s$(DRV_POS=5).driveControl01.1")
epicsEnvSet("ECMC_EC_DRV_ALARM_0",  "ec0.s$(DRV_POS=5).driveStatus01.3")    # error
epicsEnvSet("ECMC_EC_DRV_ALARM_1",  "ec0.s$(DRV_POS=5).driveStatus01.7")    # stall
epicsEnvSet("ECMC_EC_DRV_ALARM_2",  "ec0.s$(DRV_POS=5).driveStatus01.14")   # sync error
epicsEnvSet("ECMC_EC_DRV_WARNING",  "ec0.s$(DRV_POS=5).driveStatus01.2")

#Trajectory -------------------------------------------------------------------
epicsEnvSet("ECMC_TRAJ_TYPE",       "0")     # 0 = trapezoidal, 1 = ruckig S-curve
epicsEnvSet("ECMC_VELO",            "2.0")   # default velocity, mm/s
epicsEnvSet("ECMC_JOG_VEL",         "1.0")
epicsEnvSet("ECMC_ACCS_EGU_PER_S2", "10.0")
epicsEnvSet("ECMC_JAR",             "0.0")   # jerk; only used when TRAJ_TYPE=1
epicsEnvSet("ECMC_JERK",            "0.0")
epicsEnvSet("ECMC_EMERG_DECEL",     "50.0")

#Homing -----------------------------------------------------------------------
# 15 = ECMC_SEQ_HOME_SET_POS: "declare here to be ECMC_HOME_POS", no motion.
# The only honest option with no switches and no absolute encoder.
epicsEnvSet("ECMC_HOME_PROC",   "15")
epicsEnvSet("ECMC_HOME_POS",    "0.0")
epicsEnvSet("ECMC_HOME_VEL_TO", "1.0")
epicsEnvSet("ECMC_HOME_VEL_FRM","0.5")
epicsEnvSet("ECMC_HOME_ACC",    "10.0")
epicsEnvSet("ECMC_HOME_DEC",    "10.0")
epicsEnvSet("ECMC_HOME_POS_MOVE_ENA",      "0")
epicsEnvSet("ECMC_HOME_POS_MOVE_TARG_POS", "0")

#Controller -------------------------------------------------------------------
# Open loop: the position controller is bypassed. Kept at zero deliberately --
# stage 2 turns it on and explains what each term does.
epicsEnvSet("ECMC_CNTRL_KP",  "0.0")
epicsEnvSet("ECMC_CNTRL_KI",  "0.0")
epicsEnvSet("ECMC_CNTRL_KD",  "0.0")
epicsEnvSet("ECMC_CNTRL_KFF", "1.0")   # pure feed-forward: setpoint straight through

#Monitoring -------------------------------------------------------------------
# ".ONE.0" is a constant-1 entry ecmc provides on every slave. Used here to say
# "this input is always healthy" -- i.e. no switch is wired.
#
# READ THIS: with no limit switches and no software limits, NOTHING stops this
# axis at the end of travel except you. Stage 1 is for a motor on the bench.
epicsEnvSet("ECMC_EC_MON_LOWLIM",        "ec0.s$(DRV_POS=5).ONE.0")
epicsEnvSet("ECMC_EC_MON_HIGHLIM",       "ec0.s$(DRV_POS=5).ONE.0")
epicsEnvSet("ECMC_EC_MON_HOME_SWITCH",   "ec0.s$(DRV_POS=5).ONE.0")
epicsEnvSet("ECMC_EC_MON_EXT_INTERLOCK", "ec0.s$(DRV_POS=5).ONE.0")

# Soft limits disabled (0,0)
epicsEnvSet("ECMC_SOFT_LOW_LIM",  "0")
epicsEnvSet("ECMC_SOFT_HIGH_LIM", "0")
epicsEnvSet("ECMC_DXLM_ENABLE",   "0")

# Position lag monitoring OFF: meaningless when the "encoder" is the step counter.
epicsEnvSet("ECMC_MON_LAG_MON_TOL",  "1.0")
epicsEnvSet("ECMC_MON_LAG_MON_TIME", "100")
epicsEnvSet("ECMC_MON_LAG_MON_ENA",  "0")

epicsEnvSet("ECMC_MON_AT_TARGET_TOL",  "0.01")
epicsEnvSet("ECMC_MON_AT_TARGET_TIME", "100")
epicsEnvSet("ECMC_MON_AT_TARGET_ENA",  "1")

epicsEnvSet("ECMC_MON_VELO_MAX",           "12.0")
epicsEnvSet("ECMC_MON_VELO_MAX_TRAJ_TIME", "100")
epicsEnvSet("ECMC_MON_VELO_MAX_DRV_TIME",  "200")
epicsEnvSet("ECMC_MON_VELO_MAX_ENA",       "1")
