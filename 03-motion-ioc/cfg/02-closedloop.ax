# =============================================================================
# Stage 2 -- closed loop
#
# Everything from stage 1, plus a position controller that actually acts on
# following error, plus software limits so the axis has a defined travel range.
#
# An .ax file is plain iocsh, so it can include another one. The delta below IS
# the lesson: read it as a diff against stage 1.
# =============================================================================

< ./cfg/01-openloop.ax

epicsEnvSet("ECMC_DESC", "Training axis 1 (closed loop)")

# --- Controller --------------------------------------------------------------
# ecmc runs a PID on following error (setpoint - actual) and adds its output to
# the feed-forward term:
#
#   velocity_out = KFF * traj_velocity  +  PID(setpoint_pos - actual_pos)
#
#   KFF  feed-forward. 1.0 means "trust the trajectory". This does the bulk of
#        the work; the PID only corrects what feed-forward gets wrong.
#   KP   proportional. Raise until the axis tracks well, back off before it
#        buzzes or oscillates.
#   KI   integral. Removes steady-state error (gravity, friction). Small.
#        Too large -> overshoot and hunting.
#   KD   derivative. Almost always 0 here: encoder quantisation makes it noisy.
#
# TUNE THESE ON YOUR HARDWARE. These values are a starting point for a small
# stepper on a light load, not a recommendation.
epicsEnvSet("ECMC_CNTRL_KP",  "15.0")
epicsEnvSet("ECMC_CNTRL_KI",  "0.02")
epicsEnvSet("ECMC_CNTRL_KD",  "0.0")
epicsEnvSet("ECMC_CNTRL_KFF", "1.0")

# --- Following error monitoring ----------------------------------------------
# Now meaningful: if commanded and actual position disagree by more than TOL for
# longer than TIME cycles, ecmc interlocks the axis and stops it.
#
# This is the single most valuable protection on a real machine. It catches a
# jammed stage, a seized bearing, a stalled motor, a snapped coupling -- anything
# where the load stops following the command.
#
# TOL too tight -> nuisance trips during acceleration.
# TOL too loose -> the axis pushes into an obstruction before noticing.
epicsEnvSet("ECMC_MON_LAG_MON_TOL",  "0.5")     # mm
epicsEnvSet("ECMC_MON_LAG_MON_TIME", "100")     # cycles at EC_RATE -> 100 ms
epicsEnvSet("ECMC_MON_LAG_MON_ENA",  "1")

# --- Software limits ---------------------------------------------------------
# Enforced against the trajectory setpoint, so the axis decelerates cleanly
# rather than being stopped hard at the limit.
#
# These are NOT a safety system -- they depend on the position being correct,
# which before homing it is not. Hardware limit switches (stage 3) are the
# backstop; these protect against operator error in normal running.
#
# SET THESE TO YOUR ACTUAL TRAVEL. The defaults assume 50 mm of usable range.
epicsEnvSet("ECMC_SOFT_LOW_LIM",  "$(SOFT_LOW=-25.0)")
epicsEnvSet("ECMC_SOFT_HIGH_LIM", "$(SOFT_HIGH=25.0)")
epicsEnvSet("ECMC_DXLM_ENABLE",   "1")

# --- Trajectory --------------------------------------------------------------
# Switch to ruckig jerk-limited (S-curve) motion. Acceleration now ramps instead
# of stepping, which markedly reduces excitation of the mechanics.
# Set back to 0 and compare -- exercise 4.
epicsEnvSet("ECMC_TRAJ_TYPE", "$(TRAJ_TYPE=1)")
epicsEnvSet("ECMC_JERK",      "100.0")   # EGU/s^3
epicsEnvSet("ECMC_JAR",       "0.0")     # 0 -> derived from VELO/ACCL
