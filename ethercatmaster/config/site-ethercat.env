# ---------------------------------------------------------------------------
# site-ethercat.env -- the site-specific EtherCAT master settings for THIS host.
#
# These are the only values that differ between machines. apply-config.sh reads
# them and writes them into /etc/ethercat.conf, which is installed from the
# master's own template and therefore is NOT version controlled.
#
# Everything ethercatctl consumes is one of the five variables below; verified
# against script/ethercatctl.in in the 1.6.12 tree.
# ---------------------------------------------------------------------------

# The NIC dedicated to EtherCAT, by MAC.
#
# MAC rather than interface name: udev or a firmware update can rename eno1,
# and a master pointed at the wrong NIC is how you lose remote access. The MAC
# is stable. ethercatctl resolves either form (ethercatctl.in, parse_mac_address).
#
# eno1 = Intel Ethernet Connection (5) I219-LM, PCI 0000:00:1f.6, in-tree e1000e
MASTER0_DEVICE="f4:39:09:06:88:69"

# Redundancy NIC. Empty = no redundancy.
MASTER0_BACKUP=""

# Which device module drives the NIC: "generic" or a native driver ("e1000e").
#
# Start on generic: it uses only long-stable kernel socket APIs, so it works
# regardless of how far Rocky 9's backported 5.14 has drifted from upstream.
# Switch to e1000e once the bus is proven -- see INSTALL.md step 9.
DEVICE_MODULES="generic"

# Interfaces to bring up before the master starts, and down after it stops.
#
# MANDATORY with the generic driver: it opens a raw socket on the interface, so
# the link must be up before ec_master loads or every frame times out.
UPDOWN_INTERFACES="eno1"

# Extra flags passed to modprobe by ethercatctl. Normally empty.
MODPROBE_FLAGS=""

# ---------------------------------------------------------------------------
# Not read by ethercatctl -- used by apply-config.sh for the other files.
# ---------------------------------------------------------------------------

# Group granted read/write on /dev/EtherCATx and realtime priority.
ECMC_GROUP="ethercat"

# Where the master was installed (configure --prefix).
ETHERLAB="/opt/etherlab"
