# ---------------------------------------------------------------------------
# site.conf -- machine-local paths for the ecmc training course.
#
#   cp site.conf.example site.conf   and edit to match this host.
#
# site.conf is gitignored: this repo is portable, your paths are not.
# Every script in the course sources it, so it is the single place where
# "where things live on this machine" is written down.
# ---------------------------------------------------------------------------

# --- EPICS ------------------------------------------------------------------
# Base version directory, e.g. /epics/base/7.0.7
EPICS_BASE=/epics/base/7.0.7

# Module tree for this base version, e.g. /epics/modules/7.0.7
EPICS_MODULES=/epics/modules/7.0.7

# EPICS_HOST_ARCH. Auto-detected from $EPICS_BASE/startup/EpicsHostArch, but that
# returns the upstream name (linux-x86_64). Sites that build under their own name
# MUST set it explicitly -- PCDS uses rhel9-x86_64.
EPICS_HOST_ARCH=linux-x86_64

# --- Source checkouts -------------------------------------------------------
# Where you cloned the upstream repositories. These are read, never modified.
ECMC_SRC=/home/epics/src/ecmc
ECMCCFG_SRC=/home/epics/src/ecmccfg

# ecmccomp -- component definitions (motor/drive/encoder parameters).
# REQUIRED for phase 03: the EL7062 configuration lives here, not in ecmccfg.
#   git clone https://github.com/paulscherrerinstitute/ecmccomp
ECMCCOMP_SRC=/home/epics/src/ecmccomp

# --- EtherCAT ---------------------------------------------------------------
# Etherlab master installation (provides libethercat and the `ethercat` CLI)
ETHERLAB=/opt/etherlab

# --- Source dependencies ----------------------------------------------------
# Where build-deps.sh keeps libraries built from source (ruckig today).
# Site convention: $DEPS_DIR/<package>/RX.Y.Z, so several versions coexist
# and each consumer pins the one it wants.
DEPS_DIR=/opt/pkg_mgr

# --- Course workspace -------------------------------------------------------
# Where stage-ecmccfg.sh writes the flattened ecmccfg install.
# Must be writable. Defaults to <training repo>/stage.
#ECMCCFG_STAGE=/var/lib/ecmc-training/stage

# EPICS prefix for the PVs created by the course IOCs.
IOC_PREFIX=TRAIN

# --- EPICS module versions ---------------------------------------------------
# Module trees may be versioned: $EPICS_MODULES/<module>/<version>, which is the
# PCDS convention. Leave a version empty if that module sits flat directly under
# $EPICS_MODULES instead.
ASYN_MODULE_VERSION=R4.42-1.0.0
# ESS's motor fork, not stock motor: ecmcMotorRecord.template writes ACCS and
# SPAM fields that stock motorRecord.dbd doesn't define -- "Record ... does
# not have a field" at boot otherwise. Confirmed built against this ecmc and
# running.
MOTOR_MODULE_VERSION=R6.9-ess-0.0.5
ECMC_MODULE_VERSION=

# MCoreUtils -- real-time thread affinity/priority/mlock from iocsh, without
# rebooting to change isolcpus. See ethercatmaster/REALTIME.md #5.
#   https://github.com/epics-modules/MCoreUtils
MCOREUTILS_MODULE_VERSION=
